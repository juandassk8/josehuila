# Copiar a /etc/inforce/ad-library.env (modo 600), sin añadirlo al repositorio.
META_AD_LIBRARY_TOKEN=
META_GRAPH_VERSION=v26.0
ADLIB_COLLECTOR=meta_web
ADLIB_WORKER_CONCURRENCY=1
# Google Chrome estable, instalado dentro de la imagen del worker.
PLAYWRIGHT_CHANNEL=chrome
# Proxy de salida estable y opcional para el collector web (http, https o socks5).
# Sin credenciales en la URL: usar las dos variables siguientes. Vacío = IP del servidor.
# El límite y la espera de Meta se siguen respetando; no es un pool rotativo.
ADLIB_PROXY_SERVER=
ADLIB_PROXY_USERNAME=
ADLIB_PROXY_PASSWORD=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Copiar a /etc/inforce/ad-library.env (modo 600), sin añadirlo al repositorio.
META_AD_LIBRARY_TOKEN=
META_GRAPH_VERSION=v26.0
ADLIB_COLLECTOR=meta_web
ADLIB_WORKER_CONCURRENCY=1
# Google Chrome estable, instalado dentro de la imagen del worker.
PLAYWRIGHT_CHANNEL=chrome
# Proxy de salida estable y opcional para el collector web (http, https o socks5).
# Sin credenciales en la URL: usar las dos variables siguientes. Vacío = IP del servidor.
# Se intenta cada proxy configurado como máximo una vez por consulta.
# socks5 con usuario/contraseña funciona mediante un puente local en 127.0.0.1
# (Chromium no autentica SOCKS5 por sí mismo); solo admite túneles HTTPS.
ADLIB_PROXY_SERVER=
ADLIB_PROXY_USERNAME=
ADLIB_PROXY_PASSWORD=
# Respaldo opcional: falla de conexión o límite de Meta; abre un navegador limpio.
ADLIB_PROXY_BACKUP_SERVER=
ADLIB_PROXY_BACKUP_USERNAME=
ADLIB_PROXY_BACKUP_PASSWORD=
# Pausa solo al agotar las salidas. Segundos entre 60 y 3600; defecto 900 (15 min).
ADLIB_RATE_LIMIT_COOLDOWN_SECONDS=900
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

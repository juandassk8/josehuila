[Unit]
Description=Renew the short-lived Inforce IP certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/certbot-5.4/bin/certbot renew --quiet --deploy-hook "systemctl reload nginx"
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

